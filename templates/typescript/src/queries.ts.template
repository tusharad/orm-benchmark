/**
 * TypeScript ORM Interface Template for Postgres Air Heavyweight Benchmark
 * HQ01 through HQ16
 */

export interface FlightSearchParams {
  origins?: string[];
  destinations?: string[];
  minDeparture?: Date;
  maxDeparture?: Date;
  aircraftClasses?: number[];
  minRange?: number;
  statuses?: string[];
  daytimeOnly?: boolean;
  cursor?: { scheduledDeparture: Date; flightId: number };
  limit?: number;
}

export interface FlightStatusBatchItem {
  flightId: number;
  status: string;
  actualDeparture?: Date | null;
  actualArrival?: Date | null;
}

export interface HeavyweightQueries<TDb> {
  // HQ01: Massive Entity Deserialization (10,000 Wide Rows)
  hq01MassiveDeserialization(db: TDb): Promise<any[]>;

  // HQ02: Wide Multi-Join Composite Hydration (5,000 Joined Rows)
  hq02WideJoinHydration(db: TDb): Promise<any[]>;

  // HQ03: 4-Level Deep Hierarchical Entity Tree Materialization
  hq03DeepGraphFetch(db: TDb, minFlightId: number, maxFlightId: number): Promise<any[]>;

  // HQ04: Account Relationship Graph with Optional Sub-Entities
  hq04AccountGraph(db: TDb, minAccountId: number, maxAccountId: number): Promise<any[]>;

  // HQ05: Fleet & Route Profitability Analytical Ledger (5 Tables, 400k+ Rows)
  hq05RouteLedger(db: TDb, startDate: Date, endDate: Date): Promise<any[]>;

  // HQ06: Chained Multi-Stage CTEs (Airport Hub Centrality & Network Degree)
  hq06HubCentrality(db: TDb, startDate: Date, endDate: Date): Promise<any[]>;

  // HQ07: Correlated At-Capacity Subquery with Loyalty Tier Cross-Check
  hq07CapacityRiskFlights(db: TDb, startDate: Date, endDate: Date): Promise<any[]>;

  // HQ08: Recursive Multi-Hop Flight Connection Graph Search (1-3 Hops)
  hq08RecursiveRouteSearch(db: TDb, origin: string, destination: string, startDate: Date, endDate: Date): Promise<any[]>;

  // HQ09: Multi-Window Statistical Delay Dispersion & Cascades
  hq09MultiWindowDelay(db: TDb, airport: string, startDate: Date, endDate: Date): Promise<any[]>;

  // HQ10: Keyset (Cursor) Pagination over Composite Tuple Under Concurrency
  hq10KeysetPagination(db: TDb, cursor: { scheduledDeparture: Date; flightId: number }, limit: number): Promise<any[]>;

  // HQ11: High-Dimensional Dynamic Faceted Flight Search Engine (10 Optional Predicates)
  hq11DynamicFacetedSearch(db: TDb, params: FlightSearchParams): Promise<any[]>;

  // HQ12: High-Volume Batch Upsert (2,500 Records with Conflict Resolution)
  hq12BatchUpsert(db: TDb, batch: FlightStatusBatchItem[]): Promise<number>;

  // HQ13: Optimistic Concurrency Bulk Fare & Status Adjustment
  hq13OptimisticBulkUpdate(db: TDb, minFlightId: number, maxFlightId: number, expectedVersion: number, newStatus: string): Promise<number>;

  // HQ14: High-Concurrency Seat Allocation Under Contention (C=100)
  hq14ReserveSeatConcurrent(db: TDb, flightId: number, passengerName: string): Promise<string>;

  // HQ15: Distributed Financial / Points Transfer with Serialization Retry
  hq15PointsTransferSerializable(db: TDb, fromAccount: number, toAccount: number, points: number): Promise<void>;

  // HQ16: Multi-Modal Hybrid Vector Similarity + BM25 Full-Text Search with RRF Reranking
  hq16HybridSearchRRF(db: TDb, queryText: string, targetAirport: string): Promise<any[]>;
}
