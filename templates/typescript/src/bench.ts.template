    }
  });
  await Promise.all(tasks);
  const t1 = performance.now();
  const rps = (totalOps / (t1 - t0)) * 1000;
  console.log(`Throughput: ${rps.toFixed(0)} requests/sec`);

  const memAfter = process.memoryUsage();
