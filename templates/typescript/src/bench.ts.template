/**
 * TypeScript Benchmark Runner for Postgres Air
 */
import { performance } from "perf_hooks";

function calcPercentiles(numbers: number[]): { p50: number; p95: number; p99: number } {
  if (numbers.length === 0) return { p50: 0, p95: 0, p99: 0 };
  const sorted = [...numbers].sort((a, b) => a - b);
  const n = sorted.length;
  return {
    p50: sorted[Math.floor(n * 0.5)],
    p95: sorted[Math.floor(n * 0.95)],
    p99: sorted[Math.floor(n * 0.99)],
  };
}

async function measureQuery(label: string, fn: () => Promise<any>, iterations = 500) {
  // Warmup
  for (let i = 0; i < 20; i++) await fn();

  const timings: number[] = [];
  for (let i = 0; i < iterations; i++) {
    const t0 = performance.now();
    await fn();
    const t1 = performance.now();
    timings.push(t1 - t0);
  }

  const { p50, p95, p99 } = calcPercentiles(timings);
  console.log(`[${label}] p50=${p50.toFixed(2)}ms, p95=${p95.toFixed(2)}ms, p99=${p99.toFixed(2)}ms`);
  return { p50, p95, p99 };
}

