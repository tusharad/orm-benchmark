cabal-version:       2.4
name:                orville-postgres-air-bench
version:             0.1.0.0
synopsis:            Postgres Air Benchmark for Orville ORM
license:             MIT
build-type:          Simple

library
  exposed-modules:     Models
                     , Queries
  hs-source-dirs:      src
  build-depends:       base >= 4.14 && < 5
                     , orville-postgresql
                     , postgresql-simple
                     , text
                     , bytestring
                     , time
                     , scientific
                     , aeson
                     , containers
                     , deepseq
                     , unliftio
  default-language:    Haskell2010
  ghc-options:         -Wall -O2 -Wno-orphans -Wno-unused-imports -Wno-name-shadowing

executable orville-air-bench
  main-is:             Main.hs
  hs-source-dirs:      app
  build-depends:       base >= 4.14 && < 5
                     , orville-postgres-air-bench
                     , orville-postgresql
                     , postgresql-simple
                     , text
                     , bytestring
                     , time
                     , async
                     , deepseq
                     , aeson
                     , directory
                     , filepath
                     , containers
  default-language:    Haskell2010
  ghc-options:         -Wall -O2 -threaded -rtsopts "-with-rtsopts=-N -T"
