cabal-version:       2.4
name:                beam-postgres-air-bench
version:             0.1.0.0
synopsis:            Postgres Air Benchmark for Beam ORM
license:             BSD-3-Clause
build-type:          Simple

library
  exposed-modules:     Database.Beam.PostgresAir.Schema
                     , Database.Beam.PostgresAir.Queries
  hs-source-dirs:      src
  build-depends:       base >= 4.14 && < 5
                     , beam-core
                     , beam-postgres
                     , postgresql-simple
                     , text
                     , bytestring
                     , time
                     , vector
                     , scientific
                     , aeson
                     , deepseq
                     , containers
  default-language:    Haskell2010
  ghc-options:         -Wall -O2

executable beam-air-bench
  main-is:             Main.hs
  hs-source-dirs:      app
  build-depends:       base >= 4.14 && < 5
                     , beam-postgres-air-bench
                     , beam-core
                     , beam-postgres
                     , postgresql-simple
                     , text
                     , time
                     , async
                     , deepseq
                     , aeson
                     , bytestring
                     , directory
                     , filepath
                     , containers
  default-language:    Haskell2010
  ghc-options:         -Wall -O2 -threaded -rtsopts "-with-rtsopts=-N -T"
