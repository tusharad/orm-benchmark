cabal-version:       2.4
name:                persistent-postgres-air-bench
version:             0.1.0.0
synopsis:            Postgres Air Benchmark for Persistent ORM
license:             MIT
build-type:          Simple

library
  exposed-modules:     Database.Persistent.PostgresAir.Schema
                     , Database.Persistent.PostgresAir.Queries
  hs-source-dirs:      src
  build-depends:       base >= 4.14 && < 5
                     , persistent
                     , persistent-postgresql
                     , text
                     , bytestring
                     , time
                     , scientific
                     , aeson
                     , containers
                     , deepseq
                     , monad-logger
                     , unliftio
                     , resourcet
                     , template-haskell
                     , postgresql-simple
  default-language:    Haskell2010
  ghc-options:         -Wall -O2 -Wno-orphans -Wno-unused-imports -Wno-name-shadowing

executable persistent-air-bench
  main-is:             Main.hs
  hs-source-dirs:      app
  build-depends:       base >= 4.14 && < 5
                     , persistent-postgres-air-bench
                     , persistent
                     , persistent-postgresql
                     , text
                     , bytestring
                     , time
                     , async
                     , deepseq
                     , aeson
                     , monad-logger
                     , directory
                     , filepath
                     , containers
  default-language:    Haskell2010
  ghc-options:         -Wall -O2 -threaded -rtsopts "-with-rtsopts=-N -T"
