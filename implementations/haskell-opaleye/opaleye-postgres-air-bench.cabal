cabal-version:       2.4
name:                opaleye-postgres-air-bench
version:             0.1.0.0
synopsis:            Postgres Air Benchmark for Opaleye ORM
license:             BSD-3-Clause
build-type:          Simple

library
  exposed-modules:     Database.Opaleye.PostgresAir.Schema
                     , Database.Opaleye.PostgresAir.Queries
  hs-source-dirs:      src
  build-depends:       base >= 4.14 && < 5
                     , opaleye
                     , postgresql-simple
                     , product-profunctors
                     , profunctors
                     , text
                     , bytestring
                     , time
                     , scientific
                     , aeson
                     , deepseq
                     , containers
                     , template-haskell
  default-language:    Haskell2010
  ghc-options:         -Wall -O2 -Wno-orphans -Wno-unused-imports -Wno-name-shadowing

executable opaleye-air-bench
  main-is:             Main.hs
  hs-source-dirs:      app
  build-depends:       base >= 4.14 && < 5
                     , opaleye-postgres-air-bench
                     , opaleye
                     , postgresql-simple
                     , product-profunctors
                     , profunctors
                     , text
                     , bytestring
                     , time
                     , async
                     , deepseq
                     , aeson
                     , directory
                     , filepath
                     , containers
  default-language:    Haskell2010
  ghc-options:         -Wall -O2 -threaded -rtsopts "-with-rtsopts=-N -T"
