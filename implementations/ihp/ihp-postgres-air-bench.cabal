cabal-version:       2.4
name:                ihp-postgres-air-bench
version:             0.1.0.0
synopsis:            Postgres Air Benchmark for IHP Framework & ORM
license:             MIT
build-type:          Simple

library
  exposed-modules:     Models
                     , Queries
  hs-source-dirs:      src
  build-depends:       base >= 4.14 && < 5
                     , ihp
                     , postgresql-simple
                     , text
                     , bytestring
                     , time
                     , scientific
                     , aeson
                     , containers
                     , deepseq
                     , hasql
                     , hasql-pool
                     , hasql-dynamic-statements
                     , fast-logger
                     , vector
  default-language:    Haskell2010
  default-extensions:  OverloadedStrings
                     , OverloadedLabels
                     , TypeApplications
                     , DataKinds
                     , TypeFamilies
                     , FlexibleContexts
                     , FlexibleInstances
                     , MultiParamTypeClasses
                     , ScopedTypeVariables
                     , BangPatterns
                     , DeriveGeneric
                     , DeriveAnyClass
                     , ImplicitParams
                     , DuplicateRecordFields
                     , RecordWildCards
  ghc-options:         -Wall -O2 -Wno-orphans -Wno-unused-imports -Wno-name-shadowing -Wno-unused-matches

executable ihp-air-bench
  main-is:             Main.hs
  hs-source-dirs:      app
  build-depends:       base >= 4.14 && < 5
                     , ihp-postgres-air-bench
                     , ihp
                     , postgresql-simple
                     , text
                     , bytestring
                     , time
                     , scientific
                     , async
                     , deepseq
                     , aeson
                     , directory
                     , filepath
                     , containers
                     , hasql
                     , hasql-pool
                     , fast-logger
                     , vector
  default-language:    Haskell2010
  default-extensions:  OverloadedStrings
                     , OverloadedLabels
                     , TypeApplications
                     , DataKinds
                     , ScopedTypeVariables
                     , ImplicitParams
                     , RecordWildCards
  ghc-options:         -Wall -O2 -threaded -rtsopts "-with-rtsopts=-N -T"
